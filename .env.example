# Desarrollo local (frontend :3000, backend :5000)
REACT_APP_API_URL=http://localhost:5000

# Desarrollo con Ngrok (usa ngrok.yml en la raíz)
# 1. pnpm dev
# 2. pnpm ngrok  →  frontend: https://xxx.ngrok-free.dev  backend: https://yyy.ngrok-free.dev
# REACT_APP_API_URL=https://yyy.ngrok-free.dev

# Producción (frontend servido por backend, mismo origen)
# REACT_APP_API_URL=
